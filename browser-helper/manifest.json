{
  "manifest_version": 3,
  "name": "Sift Browser Helper",
  "description": "在本机浏览器中读取 YouTube 字幕或故事板，交给 Sift 生成摘要。",
  "version": "0.1.0",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*",
    "https://i.ytimg.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sift-navy-six.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["sift-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
