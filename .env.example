# 摘要模型提供方：deepseek 或 openai。建议显式配置，默认值为 deepseek。
AI_PROVIDER=deepseek

# 使用 DeepSeek 摘要时必填。
# 实验性画面识别也需要此 Key 及单独的可用视觉模型配置。
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# DeepSeek 摘要配置。以下值均可选，未填写时使用这里展示的默认值。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 实验性画面识别：仅配置服务端确实支持的视觉模型，未验证的模型名请勿填写。
# DEEPSEEK_VISION_MODEL=your_supported_vision_model
# 仅在模型服务的 Responses API 地址无法由 DEEPSEEK_BASE_URL 推导时配置完整地址。
# DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses

# 使用 OpenAI 摘要时，将 AI_PROVIDER 改为 openai，并填写 OPENAI_API_KEY。
# OPENAI_API_KEY=replace_with_your_openai_api_key
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# YouTube 字幕 Provider。配置 SUPADATA_API_KEY 后默认启用 Supadata（线上推荐）；
# 设为 direct 可强制使用 YouTube 直连解析（本地调试用）。
# YOUTUBE_TRANSCRIPT_PROVIDER=supadata

# Supadata Transcript API Key，在 https://supadata.ai 申请。
# 只在服务端使用，不要提交到 Git，也不要暴露给浏览器。
# SUPADATA_API_KEY=replace_with_your_supadata_api_key

# Supadata 可选参数（毫秒）。异步转写任务的轮询间隔、总超时和字幕缓存时长。
# SUPADATA_POLL_INTERVAL_MS=3000
# SUPADATA_POLL_TIMEOUT_MS=240000
# SUPADATA_CACHE_TTL_MS=86400000

# 摘要工作流总预算（毫秒，1000–300000），本地默认 120000，Vercel 默认 45000。
# Vercel 整个请求另有 50 秒应用预算，转写最多占用其中 25 秒。
# SUMMARY_WORKFLOW_TIMEOUT_MS=45000

# 单个视频最大时长（分钟）与所有摘要接口共享的单 IP 限流，均为可选。
# YOUTUBE_RATE_* 为兼容旧配置保留名称，限流基于单实例内存。
# YOUTUBE_MAX_DURATION_MINUTES=60
# YOUTUBE_RATE_LIMIT_MAX=12
# YOUTUBE_RATE_WINDOW_MS=600000

# Chrome 的代理扩展不会自动作用于 Node.js。
# 本地开发无法直连 YouTube 时，可填写本机 HTTP 代理地址；能够直连则保持注释。
# YOUTUBE_PROXY_URL=http://127.0.0.1:1087

# Vercel 等云端环境不能使用 127.0.0.1/localhost，它们指向云函数自身。
# 线上方案是配置 SUPADATA_API_KEY，请不要在 Vercel 上保留本机代理变量。
# 仅在确有需要时，才可填写公网可访问的 HTTP(S) 代理地址。
# YOUTUBE_PROXY_URL=https://user:password@proxy.example.com:8443

# 未设置 YOUTUBE_PROXY_URL 时，程序会依次尝试 HTTPS_PROXY 和 HTTP_PROXY。
# HTTPS_PROXY=http://127.0.0.1:1087
# HTTP_PROXY=http://127.0.0.1:1087

# Web 服务端口，可选。
PORT=3000
